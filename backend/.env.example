DATABASE_URL=postgresql+psycopg://twinauta:twinauta@localhost:5432/twinauta
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Generation is disabled until explicitly configured and executed via CLI.
ANALYSIS_PROVIDER=disabled
ANALYSIS_URL=
ANALYSIS_MODEL=
# ANALYSIS_API_KEY=configure_only_in_your_private_env
ANALYSIS_TIMEOUT_SECONDS=60
ANALYSIS_MAX_OUTPUT_TOKENS=2048
# DeepSeek supports this optional parameter; omit for other providers.
# ANALYSIS_THINKING=disabled

# Optional verified local library; omit to use the repository assets.
# SCIENTIFIC_BUNDLE_PATH=/absolute/path/to/scientific-bundle
