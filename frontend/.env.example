# Data source: "examples" reads contracts/examples; "api" calls the backend.
VITE_DATA_SOURCE=api
VITE_API_BASE_URL=/api/v1

# Terrestrial heart-rate panel (PhysioNet). Off unless "true": the dataset
# licence for redistribution is still unresolved, so keep it to local demos.
VITE_ENABLE_HEART_RATE=false
